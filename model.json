{
  "kind": "discord",
  "version": "0.1.0",
  "title": "Discord",
  "description": "Send and read Discord channel messages with a bot or a webhook.",
  "repository_url": "https://github.com/HackInvent/bloxmith-discord",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "Linux/POSIX with Python 3.10+ and TLS support, a Discord application bot token (with the Message Content intent to read message text) or a channel webhook URL stored in the BloxSmith wallet, the bot added to each allowlisted channel's server with the needed permissions, and outbound HTTPS access to discord.com."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "message",
        "title": "message",
        "accepts": [
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "file",
        "title": "file",
        "accepts": [
          "file/path",
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "messages",
        "title": "messages",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "sent",
        "title": "sent",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "enabled": false,
    "secret_ref": "",
    "webhook_secret_ref": "",
    "allowed_channels": [],
    "default_channel": "",
    "default_operation": "send_message",
    "mentions": "none",
    "allow_writes": false,
    "allow_delete": false,
    "file_root": "",
    "max_file_bytes": 10485760,
    "read_limit": 100,
    "watch": false,
    "watch_channels": [],
    "watch_interval_sec": 30,
    "emit_existing": false,
    "existing_since_hours": 1,
    "watch_max_items": 100,
    "watch_include_bots": false,
    "page_size": 100,
    "max_pages": 5,
    "timeout_sec": 30,
    "max_retries": 2,
    "max_retry_wait_sec": 30,
    "max_response_bytes": 4194304,
    "api_base_url": "https://discord.com",
    "ca_file": ""
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event",
    "file_browser": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
